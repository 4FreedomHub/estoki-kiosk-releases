# /etc/estoki-pi/updater.env, optional, owned by root. Read by estoki-pi-updater.service.
# Nothing here is a secret, and a kiosk needs none of it: releases come from the public
# 4FreedomHub/estoki-kiosk-releases, checked against /usr/local/share/estoki-pi/allowed_signers.
# ESTOKI_PI_REPO=4FreedomHub/estoki-kiosk-releases
# ESTOKI_PI_ALLOWED_SIGNERS=/usr/local/share/estoki-pi/allowed_signers
