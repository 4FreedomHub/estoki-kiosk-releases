# Lets the `video` group turn the display's backlight off and on, so the kiosk's user can sleep the
# screen. Install to /etc/udev/rules.d/; it applies from the next boot.
SUBSYSTEM=="backlight", ACTION=="add", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
